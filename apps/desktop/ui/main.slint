import { Button, ComboBox, LineEdit, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";

// ---- Building blocks -------------------------------------------------------

component SectionTitle inherits Text {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
}

component FieldLabel inherits Text {
    color: #374151;
    font-size: 12px;
    font-weight: 600;
}

component MutedText inherits Text {
    color: #6b7280;
    font-size: 12px;
}

component Panel inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: #e5e7eb;
    background: #ffffff;
}

component Separator inherits Rectangle {
    height: 1px;
    background: #e5e7eb;
}

component MonospaceList inherits ScrollView {
    in property <string> text;

    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    viewport-width: self.visible-width;

    Text {
        width: root.visible-width;
        text: root.text;
        color: #111827;
        font-size: 13px;
        font-family: "monospace";
        wrap: word-wrap;
    }
}

// One drop-down that stretches to the space it is given. Defining it once keeps
// every panel using the same control.
component TableSelector inherits ComboBox {
    in property <[string]> options;
    in-out property <int> index;
    in-out property <string> value;

    callback picked(string);

    model: root.options;
    current-index <=> root.index;
    min-width: 0px;
    horizontal-stretch: 1;

    selected(picked-value) => {
        root.value = picked-value;
        root.picked(picked-value);
    }
}

component FormatSelector inherits ComboBox {
    in-out property <int> index;
    in-out property <string> value;

    model: ["equation", "sql", "text", "mermaid", "json"];
    current-index <=> root.index;
    min-width: 0px;
    horizontal-stretch: 1;

    selected(picked-value) => {
        root.value = picked-value;
    }
}

component MaxLinksBox inherits SpinBox {
    minimum: 1;
    maximum: 8;
    min-width: 72px;
    horizontal-stretch: 1;
}

// ---- Panels ----------------------------------------------------------------

component SourcePanel inherits Panel {
    in-out property <string> source-input-label: "Fixture file";
    in-out property <string> source-input-value;
    in-out property <string> selected-source-kind: "fixture";
    in-out property <int> selected-source-index: 0;
    in-out property <string> databases-text;
    in-out property <string> tables-text;

    callback select-source(string, string, string);
    callback load-source(string, string);

    min-width: 0px;
    min-height: 220px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        SectionTitle {
            text: "Source";
            vertical-stretch: 0;
        }

        FieldLabel {
            text: root.source-input-label;
            vertical-stretch: 0;
        }

        LineEdit {
            height: 38px;
            vertical-stretch: 0;
            text <=> root.source-input-value;
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;

            ComboBox {
                horizontal-stretch: 1;
                min-width: 0px;
                model: ["fixture", "sql", "postgres"];
                current-index <=> root.selected-source-index;
                selected(value) => {
                    root.select-source(value, root.selected-source-kind, root.source-input-value);
                    root.selected-source-kind = value;
                }
            }

            Button {
                text: "Load";
                horizontal-stretch: 0;
                clicked => {
                    root.load-source(root.selected-source-kind, root.source-input-value);
                }
            }
        }

        Separator {
            vertical-stretch: 0;
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;

            SectionTitle {
                text: "Databases";
            }

            MutedText {
                text: "database";
            }
        }

        MonospaceList {
            text: root.databases-text;
            min-height: 48px;
            preferred-height: 92px;
            vertical-stretch: 1;
        }

        Separator {
            vertical-stretch: 0;
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;

            SectionTitle {
                text: "Tables";
            }

            MutedText {
                text: "schema.table";
            }
        }

        MonospaceList {
            text: root.tables-text;
            min-height: 72px;
            preferred-height: 210px;
            vertical-stretch: 3;
        }
    }
}

component PathPanel inherits Panel {
    in property <[string]> schema-options;
    in property <[string]> table-options;
    in-out property <string> selected-schema: "public";
    in-out property <int> selected-schema-index: 0;
    in-out property <string> source-table;
    in-out property <int> source-table-index: 0;
    in-out property <string> target-table;
    in-out property <int> target-table-index: 0;
    in-out property <string> selected-format: "equation";
    in-out property <int> selected-format-index: 0;
    in-out property <int> max-links: 5;

    callback select-schema(string);
    callback find-path(string, string, string, string, int);

    min-width: 0px;
    // 5 rows of ~34px + 4x10px spacing + title + action row + padding: the
    // content floor. min = max keeps the panel at exactly this height no matter
    // how tall the column is, so the leftover can only go to the Result panel.
    min-height: 360px;
    max-height: 360px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        // `start` hands every row its PREFERRED height; the default `stretch`
        // would size stretch-0 rows at their minimum and share any leftover
        // equally, inflating the drop-downs.
        alignment: start;

        SectionTitle {
            text: "Path";
            vertical-stretch: 0;
        }

        // One labelled row per control. A HorizontalLayout per row (not a
        // GridLayout) keeps the label column at a fixed width so extra space
        // goes into the input: text stays on the left of the field, only the
        // chevron sits on the right. Reading the window size would close a
        // Slint binding loop (docs/ui-guide.md).
        VerticalLayout {
            spacing: 10px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                FieldLabel {
                    text: "Schema";
                    vertical-alignment: center;
                    width: 110px;
                    horizontal-stretch: 0;
                }

                TableSelector {
                    options: root.schema-options;
                    index <=> root.selected-schema-index;
                    value <=> root.selected-schema;
                    picked(value) => {
                        root.select-schema(value);
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                FieldLabel {
                    text: "From table";
                    vertical-alignment: center;
                    width: 110px;
                    horizontal-stretch: 0;
                }

                TableSelector {
                    options: root.table-options;
                    index <=> root.source-table-index;
                    value <=> root.source-table;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                FieldLabel {
                    text: "To table";
                    vertical-alignment: center;
                    width: 110px;
                    horizontal-stretch: 0;
                }

                TableSelector {
                    options: root.table-options;
                    index <=> root.target-table-index;
                    value <=> root.target-table;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                FieldLabel {
                    text: "Format";
                    vertical-alignment: center;
                    width: 110px;
                    horizontal-stretch: 0;
                }

                FormatSelector {
                    index <=> root.selected-format-index;
                    value <=> root.selected-format;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 0;

                FieldLabel {
                    text: "Max links";
                    vertical-alignment: center;
                    width: 110px;
                    horizontal-stretch: 0;
                }

                MaxLinksBox {
                    value <=> root.max-links;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            alignment: start;

            Button {
                text: "Find path";
                horizontal-stretch: 0;
                clicked => {
                    root.find-path(root.selected-schema, root.source-table, root.target-table, root.selected-format, root.max-links);
                }
            }
        }
    }
}

component ResultPanel inherits Panel {
    in-out property <string> output-text;
    in property <string> selected-format;

    min-width: 0px;
    min-height: 140px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;

            SectionTitle {
                text: "Result";
            }

            MutedText {
                text: root.selected-format;
            }
        }

        TextEdit {
            text <=> root.output-text;
            font-size: 13px;
            font-family: "monospace";
            wrap: TextWrap.no-wrap;
            vertical-stretch: 1;
            min-height: 90px;
        }
    }
}

// ---- Window ----------------------------------------------------------------

export component AppWindow inherits Window {
    title: "Schema Pathfinder";
    background: #f8fafc;

    // The window stays freely resizable because only the preferred and minimum
    // sizes are set. Setting `width` or `height` on a Slint `Window` would lock
    // the window to a fixed size and defeat every layout constraint below.
    preferred-width: 1280px;
    preferred-height: 820px;
    // 640px is the width at which the sidebar (240px) and the result column
    // (340px) still sit side by side with their padding; 610px keeps the header,
    // the fixed-height path form (360px) and one result block visible.
    min-width: 640px;
    min-height: 610px;

    // Nothing in this file reads `root.width` or the screen size: Slint sizes a
    // resizable window from the layout info of its content, so reading the
    // width back inside the layout closes a loop. Responsiveness comes from
    // min/preferred sizes and stretch factors: the right column takes leftover
    // window width.

    in-out property <string> fixture-path;
    in-out property <string> sql-path;
    in-out property <string> database-url;
    in-out property <string> source-input-label: "Fixture file";
    in-out property <string> source-input-value;
    in-out property <string> selected-schema: "public";
    in-out property <int> selected-schema-index: 0;
    in-out property <[string]> schema-options;
    in-out property <string> source-table;
    in-out property <int> source-table-index: 0;
    in-out property <string> target-table;
    in-out property <int> target-table-index: 0;
    in-out property <[string]> table-options;
    in-out property <string> selected-format: "equation";
    in-out property <int> selected-format-index: 0;
    in-out property <int> max-links: 5;
    in-out property <string> selected-source-kind: "fixture";
    in-out property <int> selected-source-index: 0;
    in-out property <string> databases-text;
    in-out property <string> tables-text;
    in-out property <string> output-text;

    callback select-source(string, string, string);
    callback load-source(string, string);
    callback select-schema(string);
    callback find-path(string, string, string, string, int);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 56px;
            vertical-stretch: 0;
            background: #ffffff;
            border-width: 1px;
            border-color: #e5e7eb;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Schema Pathfinder";
                    color: #0f172a;
                    font-size: 18px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
        }

        // Workspace: sidebar on the left, path and result stacked on the
        // right. The right column carries the whole leftover (stretch 1) so
        // both cards grow with the window. One layout for every window size.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 16px;
            spacing: 16px;

            SourcePanel {
                horizontal-stretch: 0;
                // Shrinks first on a narrow window, stops growing on a
                // large one.
                min-width: 240px;
                preferred-width: 340px;
                max-width: 440px;
                source-input-label <=> root.source-input-label;
                source-input-value <=> root.source-input-value;
                selected-source-kind <=> root.selected-source-kind;
                selected-source-index <=> root.selected-source-index;
                databases-text <=> root.databases-text;
                tables-text <=> root.tables-text;
                select-source(next-kind, current-kind, current-value) => {
                    root.select-source(next-kind, current-kind, current-value);
                }
                load-source(kind, value) => {
                    root.load-source(kind, value);
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 340px;
                spacing: 16px;

                PathPanel {
                    vertical-stretch: 0;
                    schema-options: root.schema-options;
                    table-options: root.table-options;
                    selected-schema <=> root.selected-schema;
                    selected-schema-index <=> root.selected-schema-index;
                    source-table <=> root.source-table;
                    source-table-index <=> root.source-table-index;
                    target-table <=> root.target-table;
                    target-table-index <=> root.target-table-index;
                    selected-format <=> root.selected-format;
                    selected-format-index <=> root.selected-format-index;
                    max-links <=> root.max-links;
                    select-schema(schema) => {
                        root.select-schema(schema);
                    }
                    find-path(schema, from-table, to-table, format, links) => {
                        root.find-path(schema, from-table, to-table, format, links);
                    }
                }

                ResultPanel {
                    vertical-stretch: 1;
                    output-text <=> root.output-text;
                    selected-format: root.selected-format;
                }
            }
        }
    }
}
