import { Button, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";

component SectionTitle inherits Text {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
}

component FieldLabel inherits Text {
    color: #374151;
    font-size: 12px;
    font-weight: 600;
}

component MutedText inherits Text {
    color: #6b7280;
    font-size: 12px;
}
component Panel inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: #e5e7eb;
    background: #ffffff;
}


export component AppWindow inherits Window {
    width: 1080px;
    height: 720px;
    title: "Schema Pathfinder";
    background: #f8fafc;

    in-out property <string> fixture-path;
    in-out property <string> sql-path;
    in-out property <string> database-url;
    in-out property <string> source-input-label: "Fixture file";
    in-out property <string> source-input-value;
    in-out property <string> selected-schema: "public";
    in-out property <int> selected-schema-index: 0;
    in-out property <[string]> schema-options;
    in-out property <string> source-table;
    in-out property <int> source-table-index: 0;
    in-out property <string> target-table;
    in-out property <int> target-table-index: 0;
    in-out property <[string]> table-options;
    in-out property <string> selected-format: "equation";
    in-out property <int> selected-format-index: 0;
    in-out property <string> selected-source-kind: "fixture";
    in-out property <int> selected-source-index: 0;
    in-out property <string> databases-text;
    in-out property <string> tables-text;
    in-out property <string> output-text;

    callback select-source(string, string, string);
    callback load-source(string, string);
    callback select-schema(string);
    callback find-path(string, string, string, string);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 56px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e5e7eb;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Schema Pathfinder";
                    color: #0f172a;
                    font-size: 18px;
                    font-weight: 800;
                }

            }
        }

        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                preferred-height: 700px;

                Panel {
                    width: 310px;

                    VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    SectionTitle {
                        text: "Source";
                    }

                    FieldLabel {
                        text: root.source-input-label;
                    }

                    LineEdit {
                        height: 40px;
                        text <=> root.source-input-value;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        ComboBox {
                            horizontal-stretch: 1;
                            model: ["fixture", "sql", "postgres"];
                            current-index <=> root.selected-source-index;
                            selected(value) => {
                                root.select-source(value, root.selected-source-kind, root.source-input-value);
                                root.selected-source-kind = value;
                            }
                        }

                        Button {
                            text: "Load";
                            clicked => {
                                root.load-source(root.selected-source-kind, root.source-input-value);
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        SectionTitle {
                            text: "Databases";
                        }

                        MutedText {
                            text: "database";
                        }
                    }

                    HorizontalLayout {
                        height: 92px;
                        spacing: 8px;

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                            Text {
                                text: root.databases-text;
                                color: #111827;
                                font-size: 13px;
                                font-family: "monospace";
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        SectionTitle {
                            text: "Tables";
                        }

                        MutedText {
                            text: "schema.table";
                        }
                    }

                    HorizontalLayout {
                        height: 210px;
                        spacing: 8px;

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                            Text {
                                text: root.tables-text;
                                color: #111827;
                                font-size: 13px;
                                font-family: "monospace";
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 16px;

                Panel {
                    height: 210px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        SectionTitle {
                            text: "Path";
                        }

                        GridLayout {
                            spacing: 12px;

                            FieldLabel {
                                text: "Schema";
                                row: 0;
                                col: 0;
                            }

                            FieldLabel {
                                text: "From table";
                                row: 0;
                                col: 1;
                            }

                            FieldLabel {
                                text: "To table";
                                row: 0;
                                col: 2;
                            }

                            ComboBox {
                                model: root.schema-options;
                                current-index <=> root.selected-schema-index;
                                row: 1;
                                col: 0;
                                selected(value) => {
                                    root.selected-schema = value;
                                    root.select-schema(value);
                                }
                            }

                            ComboBox {
                                model: root.table-options;
                                current-index <=> root.source-table-index;
                                row: 1;
                                col: 1;
                                selected(value) => {
                                    root.source-table = value;
                                }
                            }

                            ComboBox {
                                model: root.table-options;
                                current-index <=> root.target-table-index;
                                row: 1;
                                col: 2;
                                selected(value) => {
                                    root.target-table = value;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            FieldLabel {
                                text: "Format";
                            }

                            ComboBox {
                                width: 180px;
                                model: ["equation", "sql", "text", "mermaid", "json"];
                                current-index <=> root.selected-format-index;
                                selected(value) => {
                                    root.selected-format = value;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: "Find path";
                                clicked => {
                                    root.find-path(root.selected-schema, root.source-table, root.target-table, root.selected-format);
                                }
                            }
                        }
                    }
                }

                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;

                            SectionTitle {
                                text: "Result";
                            }

                            MutedText {
                                text: root.selected-format;
                            }
                        }

                        TextEdit {
                            text <=> root.output-text;
                            font-size: 13px;
                            font-family: "monospace";
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
        }
    }
}
