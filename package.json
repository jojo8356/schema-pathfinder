{
  "name": "schema-pathfinder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "build:appimage": "node scripts/build_appimage.mjs",
    "build:deb": "node scripts/build_deb.mjs",
    "build:packages": "node scripts/build_deb.mjs && node scripts/build_appimage.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "node --test tests/contract_fixtures.test.mjs",
    "typecheck": "node scripts/check_scaffold.mjs",
    "lint": "node scripts/check_scaffold.mjs && node scripts/check_contract_fixtures.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@schema-pathfinder/api": "workspace:*",
    "@schema-pathfinder/core": "workspace:*"
  }
}
